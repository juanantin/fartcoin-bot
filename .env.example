# X (Twitter) App credentials
X_API_KEY=
X_API_SECRET=

# Anthropic API key
ANTHROPIC_API_KEY=

# OAuth 2.0 access token (generated in developer portal with tweet.write scope)
X_OAUTH2_TOKEN=

# OAuth 1.0a tokens — filled by: npm run auth (fallback if OAuth2 not set)
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Bot's X user ID (needed for mention replies — get from tweeterid.com)
BOT_USER_ID=

# Telegram
TG_BOT_TOKEN=
TG_CHANNEL_ID=

# Optional: override posting schedule (cron syntax, default = 3x/day)
# POST_SCHEDULE=0 8,14,20 * * *
