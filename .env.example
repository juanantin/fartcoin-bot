# X (Twitter) App credentials — from developer.twitter.com
X_API_KEY=
X_API_SECRET=

# Anthropic API key
ANTHROPIC_API_KEY=

# Bot account OAuth tokens — filled automatically by: npm run auth
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Optional: override default posting schedule (cron syntax, default = 3x/day)
# POST_SCHEDULE=0 8,14,20 * * *

# Optional: bot's own X user ID (needed for mention replies, get from developer portal)
BOT_USER_ID=
